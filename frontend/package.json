{
  "name": "tdd-hands-on-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && prettier --check src tests",
    "format": "prettier --write src tests && eslint . --fix"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
